<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытый HTTP разрешён на уровне сети, а правило держит приложение: адрес
  сервера человек вводит сам («свой сервер»), и http принимается только для
  сервера домашней сети (192.168…, 10…, 100.64/10 Tailscale, имя.local, имя без
  точки — ServerAddress.allowsCleartext); сервер в интернете — только https.
  Сказать это здесь нельзя: domain-config не умеет диапазоны адресов. На http
  экран выбора сервера предупреждает, что пароль и история видны в сети.
  Движок на этом же устройстве (ADR-0015) слушает петлю 127.0.0.1 — тоже http.

  usesCleartextTraffic в манифесте при наличии этого файла (API 24+) не
  действует: решает он.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
