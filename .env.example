# ---- core ----
CORE_HTTP_ADDR=:8080          # публичный API (наружу через Caddy)
CORE_ADMIN_ADDR=:8081         # админка под /admin; наружу её выводит Caddy тем же доменом
CORE_GRPC_ADDR=:9090          # служебный: gateway -> core (TicketService)
# Внешний адрес сервера: от него строятся ссылки и манифесты для загрузки и
# ключи входа (passkey) в админке. Локально можно не задавать.
# PUBLIC_URL=https://kino.example.org
# Как сервер назовёт себя в приложении, когда человек введёт его адрес
# (экран входа, «Сервер» в профиле). Пусто — приложение покажет адрес.
# SERVER_NAME=Кино для своих
# Регистрация: invite — только по коду приглашения из админки (по умолчанию,
# семейный сервер); open — любой, кто дошёл до сервера, заводит себе аккаунт
# сам (свой сервер для друзей и сообщества; принесённый код всё равно
# погашается); closed — людей заводит только админка.
# REGISTRATION=invite

# ---- gateway ----
GATEWAY_HTTP_ADDR=:8082
GATEWAY_CORE_GRPC=core:9090
GATEWAY_XACCEL_PREFIX=/__upstream   # internal-локация nginx для X-Accel-Redirect

# ---- площадки ----
# Ядро поставляется без площадок (ADR-0018). Они подключаются отдельно:
# пакетами на Go (cmd/*/providers.go) и скриптами на JS из SOURCES_DIR
# (docs/script-sources.md). Свои ключи и адреса каждая площадка описывает
# сама: go run ./cmd/sourcekit list.
# Какие площадки включены, через запятую. Пусто — те, что объявили себя
# включёнными по умолчанию; нет ни одной — каталог и плеер пусты.
# PROVIDERS=
# Каталог площадок-скриптов (*.js) на этой машине.
# SOURCES_DIR=
# Порядок по умолчанию: id=вес через запятую. Для отдельного тайтла его
# меняют в админке, а выбор человека в плеере важнее и того и другого.
# PROVIDER_PRIORITY=
# Склейка тайтлов аниме-площадок с мультфильмами основного каталога по
# латинскому названию: off (по умолчанию), new — для новых элементов,
# merge — ещё и слияние уже накопленных дублей.
# MATCH_ANIME_CARTOON=off
# Разметка опенингов и эндингов из AniSkip: адрес и маршрут наружу.
# ANISKIP_URL=
# ANISKIP_EGRESS=direct
# Маршруты наружу по именам: имя=адрес прокси через запятую, пустой адрес —
# напрямую. Маршрут default есть всегда (без записи — напрямую).
# EGRESS_ROUTES=default=socks5://127.0.0.1:1080,direct=
# Какой площадке какой маршрут: id=имя через запятую.
# PROVIDER_EGRESS=

# ---- crawler ----
CRAWLER_GRPC_ADDR=:9091
# Как часто идти по курсору (только изменившееся, единицы запросов).
CRAWLER_INTERVAL_MIN=30
# Полный обход — десятки тысяч запросов под тем же аккаунтом, что и просмотр.
# Поэтому только ночью и не чаще, чем раз в столько часов (84 — полнедели).
CRAWLER_FULL_EVERY_H=84
CRAWLER_NIGHT_FROM=2
CRAWLER_NIGHT_TO=6
CRAWLER_TZ=Europe/Moscow
# На сколько минут растянуть полный обход, чтобы не бить площадку залпом.
CRAWLER_FULL_SPREAD_MIN=150
# true — идти целиком на КАЖДОМ проходе. Только для первого заполнения:
# на боевом это держит аккаунт площадки в ограничении темпа круглые сутки.
CRAWLER_FULL_RESYNC=false

# ---- инфраструктура ----
POSTGRES_DSN=postgres://kino:kino@postgres:5432/kino?sslmode=disable
REDIS_ADDR=redis:6379

# ---- секреты ----
# Провайдерские креды здесь НЕ живут — они монтируются в контейнер своего провайдера.
# См. docs/adr/0004-secrets-placement.md
SESSION_SIGNING_KEY=change-me-32-bytes-minimum
TICKET_SIGNING_KEY=change-me-32-bytes-minimum

# ---- первый запуск ----
# Создаёт первого администратора на ПУСТОЙ базе и печатает otpauth-URL
# для authenticator'а. После первого старта переменные надо убрать.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=

# Потерян authenticator единственного администратора: снять его второй
# фактор при старте. При следующем входе в админку он настроит новый прямо
# на странице входа. Убрать сразу после — иначе каждый рестарт снимает снова.
ADMIN_RESET_TOTP=

# Выключать только для локальной разработки по http://localhost:
# иначе браузер не примет сессионную cookie.
CORE_SECURE_COOKIES=true

# ---- passkey в админке ----
# По умолчанию домен и origin берутся из PUBLIC_URL (локально — localhost).
# Задавать вручную нужно только если админка живёт не на PUBLIC_URL.
# WEBAUTHN_RP_ID=kino.example
# WEBAUTHN_ORIGINS=https://kino.example

# ---- служебное пространство ----
# Общий секрет для вызовов между сервисами: шлюз просит core обновить
# протухший тикет. Этот токен НЕ даёт ни пользовательского API, ни админки.
SERVICE_TOKEN=change-me-32-bytes-minimum
GATEWAY_CORE_SERVICE_URL=http://core:9090

# ---- кеш картинок ----
# Потолок в мегабайтах. Кеш чистится по давности обращения до 75% потолка.
ART_CACHE_MB=2048
